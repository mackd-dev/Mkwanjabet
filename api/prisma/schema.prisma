generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PickAccess {
  FREE
  PREMIUM
}

enum PickStatus {
  DRAFT
  PUBLISHED
  SETTLED
  CANCELLED
}

enum ResultStatus {
  PENDING
  WON
  LOST
  VOID
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum EventStatus {
  SCHEDULED
  LIVE
  SUSPENDED
  FINISHED
  POSTPONED
  CANCELLED
  ABANDONED
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
  VOID
}

enum OutcomeStatus {
  ACTIVE
  SUSPENDED
  WON
  LOST
  VOID
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MPESA
  MIXX_BY_YAS
  AIRTEL_MONEY
  HALOPESA
  TPESA
  MANUAL
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  BET_REFUND
  CASH_OUT
  BONUS_CREDIT
  BONUS_DEBIT
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum BetStatus {
  DRAFT
  BOOKED
  PLACED
  ACCEPTED
  LIVE
  WON
  LOST
  VOID
  REFUNDED
  CASHED_OUT
  REJECTED
  CANCELLED
}

enum BookingCodeStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum LimitScope {
  GLOBAL
  SPORT
  LEAGUE
  EVENT
  MARKET
  USER
}

enum ExposureScope {
  EVENT
  MARKET
  OUTCOME
}

enum SelectionStatus {
  PENDING
  WON
  LOST
  VOID
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum LimitPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id              String                   @id @default(cuid())
  name            String
  phone           String                   @unique
  email           String?                  @unique
  passwordHash    String
  role            UserRole                 @default(USER)
  status          UserStatus               @default(ACTIVE)
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  subscriptions   Subscription[]
  payments        Payment[]
  savedPicks      SavedPick[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  wallet          Wallet?
  bets            Bet[]
  kycProfile      KycProfile?
  gamingLimits    ResponsibleGamingLimit[]
  bookingCodes    BookingCode[]

  @@index([status])
}

model League {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String
  logoUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]
  matches   Match[]
}

model Team {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  shortCode  String
  logoUrl    String?
  leagueId   String?
  league     League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  homeGames  Match[]  @relation("HomeTeam")
  awayGames  Match[]  @relation("AwayTeam")
  homeEvents Event[]  @relation("EventHomeTeam")
  awayEvents Event[]  @relation("EventAwayTeam")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leagueId])
}

model Match {
  id         String      @id @default(cuid())
  slug       String      @unique
  leagueId   String
  homeTeamId String
  awayTeamId String
  kickoffAt  DateTime
  status     MatchStatus @default(SCHEDULED)
  homeScore  Int?
  awayScore  Int?
  externalId String?     @unique
  venue      String?
  league     League      @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  picks      Pick[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([kickoffAt, status])
  @@index([leagueId])
}

model Sport {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  code         String        @unique
  iconUrl      String?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  countries    Country[]
  competitions Competition[]
  events       Event[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([active, sortOrder])
}

model Country {
  id           String        @id @default(cuid())
  sportId      String?
  name         String
  slug         String        @unique
  isoCode      String?       @unique
  flagEmoji    String?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  sport        Sport?        @relation(fields: [sportId], references: [id], onDelete: SetNull)
  competitions Competition[]
  events       Event[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sportId, active, sortOrder])
  @@index([active, sortOrder])
}

model Competition {
  id         String   @id @default(cuid())
  sportId    String
  countryId  String?
  name       String
  slug       String
  externalId String?  @unique
  logoUrl    String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  country    Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  seasons    Season[]
  events     Event[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sportId, slug])
  @@index([sportId, active, sortOrder])
  @@index([countryId, active, sortOrder])
}

model Season {
  id            String      @id @default(cuid())
  competitionId String
  name          String
  slug          String
  startsAt      DateTime?
  endsAt        DateTime?
  current       Boolean     @default(false)
  active        Boolean     @default(true)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  events        Event[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, slug])
  @@index([competitionId, current])
  @@index([active])
}

model Event {
  id               String      @id @default(cuid())
  sportId          String
  countryId        String?
  competitionId    String
  seasonId         String?
  homeTeamId       String?
  awayTeamId       String?
  slug             String      @unique
  externalId       String?     @unique
  name             String
  startsAt         DateTime
  status           EventStatus @default(SCHEDULED)
  homeTeamName     String?
  awayTeamName     String?
  homeScore        Int?
  awayScore        Int?
  venue            String?
  liveClock        String?
  suspendedAt      DateTime?
  suspensionReason String?
  sport            Sport       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  country          Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season           Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeTeam         Team?       @relation("EventHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam         Team?       @relation("EventAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  markets          Market[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([sportId, status, startsAt])
  @@index([competitionId, status, startsAt])
  @@index([seasonId, startsAt])
  @@index([countryId, startsAt])
}

model Market {
  id               String       @id @default(cuid())
  eventId          String
  key              String
  name             String
  line             Decimal?     @db.Decimal(12, 4)
  status           MarketStatus @default(OPEN)
  minimumStakeTzs  Decimal?     @db.Decimal(14, 2)
  maximumStakeTzs  Decimal?     @db.Decimal(14, 2)
  maximumPayoutTzs Decimal?     @db.Decimal(14, 2)
  sortOrder        Int          @default(0)
  suspendedAt      DateTime?
  suspensionReason String?
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  outcomes         Outcome[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([eventId, key, line])
  @@index([eventId, status, sortOrder])
  @@index([status])
}

model Outcome {
  id          String        @id @default(cuid())
  marketId    String
  key         String
  name        String
  status      OutcomeStatus @default(ACTIVE)
  currentOdds Decimal?      @db.Decimal(12, 4)
  probability Decimal?      @db.Decimal(7, 4)
  sortOrder   Int           @default(0)
  settledAt   DateTime?
  market      Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  oddsHistory Odds[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([marketId, key])
  @@index([marketId, status, sortOrder])
  @@index([status])
}

model Odds {
  id            String   @id @default(cuid())
  outcomeId     String
  price         Decimal  @db.Decimal(12, 4)
  previousPrice Decimal? @db.Decimal(12, 4)
  probability   Decimal? @db.Decimal(7, 4)
  margin        Decimal? @db.Decimal(7, 4)
  source        String?
  effectiveAt   DateTime @default(now())
  outcome       Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([outcomeId, effectiveAt])
  @@index([source, effectiveAt])
}

model Pick {
  id           String              @id @default(cuid())
  matchId      String
  slug         String              @unique
  title        String
  market       String
  selection    String
  odds         Decimal             @db.Decimal(7, 2)
  confidence   Int
  risk         RiskLevel
  access       PickAccess          @default(FREE)
  status       PickStatus          @default(DRAFT)
  result       ResultStatus        @default(PENDING)
  analysis     String              @db.Text
  shortReason  String?
  featured     Boolean             @default(false)
  publishedAt  DateTime?
  settledAt    DateTime?
  match        Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  factors      PickFactor[]
  alternatives AlternativeMarket[]
  savedBy      SavedPick[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, publishedAt])
  @@index([access, result])
  @@index([featured])
}

model PickFactor {
  id        String  @id @default(cuid())
  pickId    String
  label     String
  score     Int
  detail    String?
  sortOrder Int     @default(0)
  pick      Pick    @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@index([pickId, sortOrder])
}

model AlternativeMarket {
  id        String    @id @default(cuid())
  pickId    String
  market    String
  selection String
  odds      Decimal   @db.Decimal(7, 2)
  risk      RiskLevel
  pick      Pick      @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@index([pickId])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  priceTzs      Int
  durationDays  Int
  active        Boolean        @default(true)
  popular       Boolean        @default(false)
  features      String[]
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  expiresAt DateTime?
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

model Payment {
  id             String          @id @default(cuid())
  userId         String
  planId         String?
  subscriptionId String?
  provider       PaymentProvider
  providerRef    String?         @unique
  phone          String
  amountTzs      Int
  status         PaymentStatus   @default(PENDING)
  failureReason  String?
  paidAt         DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan           Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

model SavedPick {
  userId    String
  pickId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pick      Pick     @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@id([userId, pickId])
  @@index([pickId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Wallet {
  id                  String              @id @default(cuid())
  userId              String              @unique
  availableBalanceTzs Int                 @default(0)
  withdrawableTzs     Int                 @default(0)
  bonusBalanceTzs     Int                 @default(0)
  lockedBalanceTzs    Int                 @default(0)
  version             Int                 @default(0)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        WalletTransaction[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model WalletTransaction {
  id              String                  @id @default(cuid())
  walletId        String
  type            WalletTransactionType
  status          WalletTransactionStatus @default(PENDING)
  amountTzs       Int
  balanceAfterTzs Int?
  provider        PaymentProvider?
  providerRef     String?                 @unique
  reference       String                  @unique
  description     String?
  metadata        Json?
  wallet          Wallet                  @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())
  completedAt     DateTime?

  @@index([walletId, createdAt])
  @@index([status, type])
}

model Bet {
  id                 String             @id @default(cuid())
  userId             String
  ticketCode         String             @unique
  bookingCode        String?
  status             BetStatus          @default(PLACED)
  stakeTzs           Int
  totalOdds          Decimal            @db.Decimal(12, 4)
  potentialReturnTzs Int
  payoutTzs          Int                @default(0)
  cashOutOfferTzs    Int?
  acceptedAt         DateTime?
  placedAt           DateTime           @default(now())
  settledAt          DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  selections         BetSelection[]
  history            BetStatusHistory[]
  cashOutOffers      CashOutOffer[]

  @@index([userId, status, placedAt])
  @@index([bookingCode])
}

model BetSelection {
  id              String          @id @default(cuid())
  betId           String
  externalEventId String
  sport           String
  league          String
  marketId        String
  outcomeId       String
  matchName       String
  marketName      String
  selection       String
  odds            Decimal         @db.Decimal(12, 4)
  status          SelectionStatus @default(PENDING)
  result          String?
  bet             Bet             @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@index([betId, status])
  @@index([externalEventId, marketId, outcomeId])
}

model BookingCode {
  id         String            @id @default(cuid())
  code       String            @unique
  userId     String?
  status     BookingCodeStatus @default(ACTIVE)
  stakeTzs   Int?
  selections Json
  expiresAt  DateTime
  usedAt     DateTime?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model BetStatusHistory {
  id         String     @id @default(cuid())
  betId      String
  fromStatus BetStatus?
  toStatus   BetStatus
  reason     String?
  actorId    String?
  metadata   Json?
  bet        Bet        @relation(fields: [betId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@index([betId, createdAt])
}

model StakeLimit {
  id                String     @id @default(cuid())
  scope             LimitScope
  referenceId       String     @default("*")
  minimumStakeTzs   Int        @default(500)
  maximumStakeTzs   Int        @default(2000000)
  maximumPayoutTzs  Int        @default(100000000)
  maximumOdds       Decimal    @default(1000) @db.Decimal(12, 4)
  maximumSelections Int        @default(30)
  active            Boolean    @default(true)
  priority          Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([scope, referenceId])
  @@index([active, priority])
}

model Exposure {
  id                 String        @id @default(cuid())
  scope              ExposureScope
  eventId            String
  marketId           String        @default("")
  outcomeId          String        @default("")
  stakeTzs           Int           @default(0)
  potentialPayoutTzs Int           @default(0)
  liabilityTzs       Int           @default(0)
  ticketCount        Int           @default(0)
  updatedAt          DateTime      @updatedAt
  createdAt          DateTime      @default(now())

  @@unique([scope, eventId, marketId, outcomeId])
  @@index([eventId, liabilityTzs])
}

model CashOutOffer {
  id         String    @id @default(cuid())
  betId      String
  amountTzs  Int
  acceptedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  bet        Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([betId, expiresAt])
}

model KycProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  nidaNumber      String?   @unique
  dateOfBirth     DateTime?
  frontImageUrl   String?
  backImageUrl    String?
  selfieImageUrl  String?
  status          KycStatus @default(NOT_STARTED)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, submittedAt])
}

model OperatorSettings {
  id                                  String   @id @default("default")
  bettingEnabled                      Boolean  @default(true)
  minimumBookingStakeTzs              Int      @default(500)
  depositsEnabled                     Boolean  @default(true)
  withdrawalsEnabled                  Boolean  @default(true)
  minimumDepositTzs                   Int      @default(1000)
  maximumDepositTzs                   Int      @default(10000000)
  dailyDepositLimitTzs                Int      @default(20000000)
  minimumWithdrawalTzs                Int      @default(1000)
  maximumWithdrawalTzs                Int      @default(5000000)
  dailyWithdrawalLimitTzs             Int      @default(10000000)
  manualReviewWithdrawalTzs           Int      @default(500000)
  requirePhoneVerificationForBetting  Boolean  @default(false)
  requirePhoneVerificationForWithdraw Boolean  @default(false)
  maximumUnverifiedStakeTzs           Int      @default(50000)
  maximumUnverifiedPayoutTzs          Int      @default(500000)
  maintenanceMessage                  String?
  updatedBy                           String?
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt
}
model ResponsibleGamingLimit {
  id          String      @id @default(cuid())
  userId      String
  type        String
  period      LimitPeriod
  amountTzs   Int?
  minutes     Int?
  active      Boolean     @default(true)
  effectiveAt DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, type, period])
  @@index([userId, active])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
