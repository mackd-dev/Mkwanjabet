generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PickAccess {
  FREE
  PREMIUM
}

enum PickStatus {
  DRAFT
  PUBLISHED
  SETTLED
  CANCELLED
}

enum ResultStatus {
  PENDING
  WON
  LOST
  VOID
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MPESA
  MIXX_BY_YAS
  AIRTEL_MONEY
  HALOPESA
  TPESA
  MANUAL
}

model User {
  id              String             @id @default(cuid())
  name            String
  phone           String             @unique
  email           String?            @unique
  passwordHash    String
  role            UserRole           @default(USER)
  status          UserStatus         @default(ACTIVE)
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscriptions   Subscription[]
  payments        Payment[]
  savedPicks      SavedPick[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([status])
}

model League {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String
  logoUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]
  matches   Match[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  shortCode String
  logoUrl   String?
  leagueId  String?
  league    League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  homeGames Match[]  @relation("HomeTeam")
  awayGames Match[]  @relation("AwayTeam")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
}

model Match {
  id            String      @id @default(cuid())
  slug          String      @unique
  leagueId      String
  homeTeamId    String
  awayTeamId    String
  kickoffAt     DateTime
  status        MatchStatus @default(SCHEDULED)
  homeScore     Int?
  awayScore     Int?
  externalId    String?     @unique
  venue         String?
  league        League      @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  picks         Pick[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([kickoffAt, status])
  @@index([leagueId])
}

model Pick {
  id              String       @id @default(cuid())
  matchId         String
  slug            String       @unique
  title           String
  market          String
  selection       String
  odds            Decimal      @db.Decimal(7, 2)
  confidence      Int
  risk            RiskLevel
  access          PickAccess   @default(FREE)
  status          PickStatus   @default(DRAFT)
  result          ResultStatus @default(PENDING)
  analysis        String       @db.Text
  shortReason     String?
  featured        Boolean      @default(false)
  publishedAt     DateTime?
  settledAt       DateTime?
  match           Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  factors         PickFactor[]
  alternatives    AlternativeMarket[]
  savedBy         SavedPick[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([access, result])
  @@index([featured])
}

model PickFactor {
  id       String @id @default(cuid())
  pickId   String
  label    String
  score    Int
  detail   String?
  sortOrder Int   @default(0)
  pick     Pick   @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@index([pickId, sortOrder])
}

model AlternativeMarket {
  id        String  @id @default(cuid())
  pickId    String
  market    String
  selection String
  odds      Decimal @db.Decimal(7, 2)
  risk      RiskLevel
  pick      Pick    @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@index([pickId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  priceTzs     Int
  durationDays Int
  active       Boolean  @default(true)
  popular      Boolean  @default(false)
  features     String[]
  sortOrder    Int      @default(0)
  subscriptions Subscription[]
  payments     Payment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  expiresAt DateTime?
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

model Payment {
  id             String          @id @default(cuid())
  userId         String
  planId         String?
  subscriptionId String?
  provider       PaymentProvider
  providerRef    String?         @unique
  phone          String
  amountTzs      Int
  status         PaymentStatus   @default(PENDING)
  failureReason  String?
  paidAt         DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan           Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

model SavedPick {
  userId    String
  pickId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pick      Pick     @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@id([userId, pickId])
  @@index([pickId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}
